# Local development defaults for Digital Church OS (NON-SECRET).
# The Cloud Agent install step copies this to `.env` when no `.env` exists yet.
#
# These values are enough to run the core app end to end (Next.js + local
# PostgreSQL + Prisma + credential auth). The third-party integrations
# (OpenAI, Stripe, Pinecone, Resend, Sentry, Google OAuth) are OPTIONAL: add
# their keys as environment secrets only when you want to exercise them.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (local PostgreSQL managed by .cursor/postgres.sh)
DATABASE_URL="postgresql://postgres:password@localhost:5432/digital_church_os"
DIRECT_URL="postgresql://postgres:password@localhost:5432/digital_church_os"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-only-secret-change-in-production-please-32chars"
