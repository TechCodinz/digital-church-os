# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/digital_church_os"
DIRECT_URL="postgresql://postgres:password@localhost:5432/digital_church_os"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_SERVER="smtp.resend.com"
EMAIL_PORT="587"
EMAIL_USER="resend"
EMAIL_PASSWORD="your-resend-api-key"
EMAIL_FROM="noreply@digitalchurch.os"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# AI & Search
OPENAI_API_KEY="sk-..."
PINECONE_API_KEY="pc_..."
PINECONE_INDEX="digital-church-scripture"

# Live Service
# Safe public stream configuration fallback. After the site_config migration,
# non-secret values saved in Admin Settings override these environment defaults.
LIVE_STREAM_URL=""
LIVE_STREAM_TITLE="Live Worship Service"

# Cloud Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN="cmd_..."

# Security & Cron
CRON_SECRET="your-cron-secret"

# Redis (for rate limiting and caching)
REDIS_URL="redis://localhost:6379"

# Sentry (for error tracking)
NEXT_PUBLIC_SENTRY_DSN="https://..."
SENTRY_ENVIRONMENT="production"
